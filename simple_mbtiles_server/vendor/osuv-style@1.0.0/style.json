{
  "version": 8,
  "name": "osuv-style",
  "metadata": {
    "mapbox:autocomposite": false,
    "mapbox:type": "template",
    "openmaptiles:version": "3.x",
    "maputnik:renderer": "mbgljs"
  },
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://api.maptiler.com/tiles/v3/tiles.json?key=get_your_own_key"
    }
  },
  "sprite": "",
  "glyphs": "https://api.maptiler.com/fonts/{fontstack}/{range}.pbf?key=get_your_own_key",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": [
          "interpolate", ["linear"], ["zoom"],
          0, "#ebefe0",
          6, "#ebefe0",
          7, "#f6f4ee"
        ]
      }
    },

    {
      "id": "water-political",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "maxzoom": 7,
      "paint": {
        "fill-color": "#a9c9dc",
        "fill-opacity": 1
      }
    },

    {
      "id": "water-outdoor",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "minzoom": 7,
      "paint": {
        "fill-color": "#8fc0da",
        "fill-opacity": 1
      }
    },

    {
      "id": "waterway-river",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "minzoom": 9,
      "filter": ["in", "class", "river", "canal"],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#8fc0da",
        "line-width": ["interpolate", ["linear"], ["zoom"], 9, 0.8, 14, 3]
      }
    },
    {
      "id": "waterway-stream",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "minzoom": 12,
      "filter": ["in", "class", "stream", "ditch"],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#74aecb",
        "line-width": ["interpolate", ["linear"], ["zoom"], 12, 0.6, 16, 2]
      }
    },

    {
      "id": "landcover-wood",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "minzoom": 7,
      "filter": ["==", "class", "wood"],
      "paint": {
        "fill-color": "#c2d9b2",
        "fill-opacity": ["interpolate", ["linear"], ["zoom"], 7, 0.65, 12, 0.85]
      }
    },
    {
      "id": "landcover-grass",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "minzoom": 7,
      "filter": ["in", "class", "grass", "meadow"],
      "paint": {
        "fill-color": "#dcead0",
        "fill-opacity": 0.75
      }
    },
    {
      "id": "landcover-rock",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "minzoom": 9,
      "filter": ["in", "class", "rock", "bare_rock", "scree"],
      "paint": {
        "fill-color": "#e3e0da",
        "fill-opacity": ["interpolate", ["linear"], ["zoom"], 9, 0.5, 12, 0.85]
      }
    },
    {
      "id": "landcover-ice",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["in", "class", "ice", "snow"],
      "paint": {
        "fill-color": "#eef5f8",
        "fill-opacity": 0.9
      }
    },
    {
      "id": "landcover-sand",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "minzoom": 7,
      "filter": ["in", "class", "sand", "beach"],
      "paint": {
        "fill-color": "#f0e8d4",
        "fill-opacity": 0.8
      }
    },

    {
      "id": "landuse-park",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "minzoom": 7,
      "filter": ["in", "class", "park", "pitch", "playground", "nature_reserve", "national_park"],
      "paint": {
        "fill-color": "#cfe3bd",
        "fill-opacity": 0.6
      }
    },
    {
      "id": "landuse-cemetery",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "minzoom": 12,
      "filter": ["==", "class", "cemetery"],
      "paint": {
        "fill-color": "#cce0c8",
        "fill-opacity": 0.7
      }
    },
    {
      "id": "landuse-residential",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "minzoom": 9,
      "filter": ["in", "class", "residential", "suburb"],
      "paint": {
        "fill-color": "#eae6df",
        "fill-opacity": 0.6
      }
    },
    {
      "id": "landuse-commercial-industrial",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "minzoom": 10,
      "filter": ["in", "class", "commercial", "industrial", "retail"],
      "paint": {
        "fill-color": "#e8d8c8",
        "fill-opacity": 0.5
      }
    },

    {
      "id": "building",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 13,
      "paint": {
        "fill-color": "#d9cfc4",
        "fill-opacity": 0.8,
        "fill-outline-color": "#c8bfb5"
      }
    },

    {
      "id": "road-motorway-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 7,
      "filter": ["==", "class", "motorway"],
      "layout": {"line-cap": "butt", "line-join": "miter"},
      "paint": {
        "line-color": "#d99f66",
        "line-width": ["interpolate", ["linear"], ["zoom"], 7, 1, 14, 10]
      }
    },
    {
      "id": "road-motorway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 7,
      "filter": ["==", "class", "motorway"],
      "layout": {"line-cap": "round", "line-join": "round"},
      "paint": {
        "line-color": "#f7c98d",
        "line-width": ["interpolate", ["linear"], ["zoom"], 7, 0.5, 14, 7]
      }
    },
    {
      "id": "road-trunk-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 8,
      "filter": ["==", "class", "trunk"],
      "layout": {"line-cap": "butt", "line-join": "miter"},
      "paint": {
        "line-color": "#d3a56e",
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 1, 14, 9]
      }
    },
    {
      "id": "road-trunk",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 8,
      "filter": ["==", "class", "trunk"],
      "layout": {"line-cap": "round", "line-join": "round"},
      "paint": {
        "line-color": "#f5d5a0",
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 0.5, 14, 6]
      }
    },
    {
      "id": "road-primary-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 9,
      "filter": ["==", "class", "primary"],
      "layout": {"line-cap": "butt", "line-join": "miter"},
      "paint": {
        "line-color": "#c8a878",
        "line-width": ["interpolate", ["linear"], ["zoom"], 9, 1, 14, 8]
      }
    },
    {
      "id": "road-primary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 9,
      "filter": ["==", "class", "primary"],
      "layout": {"line-cap": "round", "line-join": "round"},
      "paint": {
        "line-color": "#fbe7bc",
        "line-width": ["interpolate", ["linear"], ["zoom"], 9, 0.5, 14, 5]
      }
    },
    {
      "id": "road-secondary-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 10,
      "filter": ["==", "class", "secondary"],
      "layout": {"line-cap": "butt", "line-join": "miter"},
      "paint": {
        "line-color": "#c2bda8",
        "line-width": ["interpolate", ["linear"], ["zoom"], 10, 0.5, 14, 6]
      }
    },
    {
      "id": "road-secondary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 10,
      "filter": ["==", "class", "secondary"],
      "layout": {"line-cap": "round", "line-join": "round"},
      "paint": {
        "line-color": "#fdf6dd",
        "line-width": ["interpolate", ["linear"], ["zoom"], 10, 0.5, 14, 4]
      }
    },
    {
      "id": "road-tertiary-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 11,
      "filter": ["in", "class", "tertiary", "unclassified"],
      "layout": {"line-cap": "butt", "line-join": "miter"},
      "paint": {
        "line-color": "#c0bcb4",
        "line-width": ["interpolate", ["linear"], ["zoom"], 11, 1.5, 14, 6]
      }
    },
    {
      "id": "road-tertiary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 11,
      "filter": ["in", "class", "tertiary", "unclassified"],
      "layout": {"line-cap": "round", "line-join": "round"},
      "paint": {
        "line-color": "#ffffff",
        "line-width": ["interpolate", ["linear"], ["zoom"], 11, 0.5, 14, 3.5]
      }
    },
    {
      "id": "road-minor",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 13,
      "filter": ["in", "class", "minor", "service", "track"],
      "layout": {"line-cap": "round", "line-join": "round"},
      "paint": {
        "line-color": "#ffffff",
        "line-width": ["interpolate", ["linear"], ["zoom"], 13, 0.5, 16, 2.5]
      }
    },

    {
      "id": "path-hiking",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 11,
      "filter": ["all",
        ["==", "class", "path"],
        ["!=", "subclass", "cycleway"]
      ],
      "layout": {"line-cap": "round", "line-join": "round"},
      "paint": {
        "line-color": ["match", ["get", "sac_scale"],
          "hiking",                    "#e8a010",
          "mountain_hiking",           "#1060b0",
          "demanding_mountain_hiking", "#0a3d78",
          "alpine_hiking",             "#5b21b6",
          "demanding_alpine_hiking",   "#3b0764",
          "difficult_alpine_hiking",   "#18181b",
          "#d04020"
        ],
        "line-width": ["interpolate", ["linear"], ["zoom"],
          11, 0.8,
          15, ["match", ["get", "sac_scale"],
            "alpine_hiking",           3.0,
            "demanding_alpine_hiking", 3.0,
            "difficult_alpine_hiking", 3.0,
            2.5]
        ],
        "line-dasharray": [2, 2]
      }
    },
    {
      "id": "path-via-ferrata-halo",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 13,
      "filter": ["all",
        ["==", "class", "path"],
        ["any", ["has", "via_ferrata_scale"], ["==", "ladder", "yes"]]
      ],
      "layout": {"line-cap": "butt", "line-join": "round"},
      "paint": {
        "line-color": "#ffffff",
        "line-width": ["interpolate", ["linear"], ["zoom"], 13, 4.0, 16, 7.5],
        "line-opacity": 0.7
      }
    },
    {
      "id": "path-via-ferrata",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 13,
      "filter": ["all",
        ["==", "class", "path"],
        ["any", ["has", "via_ferrata_scale"], ["==", "ladder", "yes"]]
      ],
      "layout": {"line-cap": "butt", "line-join": "round"},
      "paint": {
        "line-color": "#dc2626",
        "line-width": ["interpolate", ["linear"], ["zoom"], 13, 2.0, 16, 4.5],
        "line-dasharray": [0.8, 1.2]
      }
    },
    {
      "id": "path-cycleway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 11,
      "filter": ["any",
        ["==", "class", "cycleway"],
        ["all", ["==", "class", "path"], ["==", "subclass", "cycleway"]]
      ],
      "layout": {"line-cap": "round", "line-join": "round"},
      "paint": {
        "line-color": "#1060b0",
        "line-width": ["interpolate", ["linear"], ["zoom"], 11, 0.8, 15, 2.5],
        "line-dasharray": [3, 1.5]
      }
    },

    {
      "id": "rail",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 10,
      "filter": ["in", "class", "rail", "transit"],
      "layout": {"line-join": "round"},
      "paint": {
        "line-color": "#888888",
        "line-width": ["interpolate", ["linear"], ["zoom"], 10, 0.5, 14, 2],
        "line-dasharray": [4, 2]
      }
    },

    {
      "id": "boundary-country-political",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "maxzoom": 7,
      "filter": ["all",
        ["<=", "admin_level", 2],
        ["==", "$type", "LineString"]
      ],
      "layout": {"line-cap": "round", "line-join": "round"},
      "paint": {
        "line-color": "#666666",
        "line-width": ["interpolate", ["linear"], ["zoom"], 0, 0.8, 6, 2.5]
      }
    },
    {
      "id": "boundary-country-outdoor",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "minzoom": 7,
      "filter": ["all",
        ["<=", "admin_level", 2],
        ["==", "$type", "LineString"]
      ],
      "layout": {"line-cap": "round", "line-join": "round"},
      "paint": {
        "line-color": "#9a8fa8",
        "line-width": ["interpolate", ["linear"], ["zoom"], 7, 1.2, 12, 2.5],
        "line-dasharray": [4, 2],
        "line-opacity": 0.8
      }
    },
    {
      "id": "boundary-state",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "minzoom": 7,
      "filter": ["all",
        ["==", "admin_level", 4],
        ["==", "$type", "LineString"]
      ],
      "layout": {"line-cap": "round", "line-join": "round"},
      "paint": {
        "line-color": "#b0a8bc",
        "line-width": ["interpolate", ["linear"], ["zoom"], 7, 0.7, 12, 1.6],
        "line-dasharray": [3, 3],
        "line-opacity": 0.7
      }
    },

    {
      "id": "waterway-name",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "minzoom": 11,
      "filter": ["==", "$type", "LineString"],
      "layout": {
        "symbol-placement": "line",
        "text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Italic"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 11, 11, 16, 16],
        "text-letter-spacing": 0.1
      },
      "paint": {
        "text-color": "#2060a0",
        "text-halo-color": "rgba(255,255,255,0.8)",
        "text-halo-width": 1.5
      }
    },

    {
      "id": "water-name-lake",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "water_name",
      "minzoom": 8,
      "filter": ["==", "$type", "Point"],
      "layout": {
        "text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Italic"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 8, 12, 14, 16],
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#2060a0",
        "text-halo-color": "rgba(255,255,255,0.7)",
        "text-halo-width": 1.5
      }
    },

    {
      "id": "road-name",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "minzoom": 12,
      "filter": ["==", "$type", "LineString"],
      "layout": {
        "symbol-placement": "line",
        "text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Bold"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 12, 11, 16, 15],
        "text-letter-spacing": 0.05,
        "text-rotation-alignment": "map"
      },
      "paint": {
        "text-color": "#333333",
        "text-halo-color": "rgba(255,255,255,0.9)",
        "text-halo-width": 2
      }
    },

    {
      "id": "poi-label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "poi",
      "minzoom": 13,
      "filter": ["all",
        ["==", "$type", "Point"],
        ["<=", "rank", 2]
      ],
      "layout": {
        "text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Bold"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 13, 12, 17, 16],
        "text-anchor": "top",
        "text-offset": [0, 0.4],
        "text-max-width": 8,
        "symbol-sort-key": ["get", "rank"]
      },
      "paint": {
        "text-color": "#1a4a1a",
        "text-halo-color": "rgba(255,255,255,0.85)",
        "text-halo-width": 2
      }
    },

    {
      "id": "mountain-peak",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "mountain_peak",
      "minzoom": 10,
      "filter": ["all",
        ["==", "$type", "Point"],
        ["in", "class", "peak", "volcano"]
      ],
      "layout": {
        "text-field": [
          "case",
          ["all", ["has", "name"], ["has", "ele"]],
          ["concat", "▲\n", ["coalesce", ["get", "name:latin"], ["get", "name"]], "\n", ["get", "ele"], " m"],
          ["has", "name"],
          ["concat", "▲\n", ["coalesce", ["get", "name:latin"], ["get", "name"]]],
          ["has", "ele"],
          ["concat", "▲\n", ["get", "ele"], " m"],
          "▲"
        ],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 10, 10, 14, 12],
        "text-line-height": 1.15,
        "text-anchor": "top",
        "text-offset": [0, -0.6],
        "text-max-width": 9,
        "symbol-sort-key": ["get", "rank"]
      },
      "paint": {
        "text-color": "#5a4a3a",
        "text-halo-color": "rgba(255,255,255,0.85)",
        "text-halo-width": 1.5
      }
    },

    {
      "id": "place-village",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 10,
      "filter": ["all",
        ["==", "$type", "Point"],
        ["in", "class", "village", "hamlet", "suburb", "quarter", "neighbourhood"]
      ],
      "layout": {
        "text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 10, 10, 14, 14],
        "text-anchor": "center",
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#333333",
        "text-halo-color": "rgba(255,255,255,0.85)",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "place-town",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 8,
      "filter": ["all",
        ["==", "$type", "Point"],
        ["==", "class", "town"]
      ],
      "layout": {
        "text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Bold"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 8, 12, 14, 18],
        "text-anchor": "center",
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#222222",
        "text-halo-color": "rgba(255,255,255,0.9)",
        "text-halo-width": 2
      }
    },
    {
      "id": "place-city",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 5,
      "filter": ["all",
        ["==", "$type", "Point"],
        ["==", "class", "city"]
      ],
      "layout": {
        "text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Bold"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 5, 11, 12, 20],
        "text-anchor": "center",
        "text-max-width": 10
      },
      "paint": {
        "text-color": "#111111",
        "text-halo-color": "rgba(255,255,255,0.9)",
        "text-halo-width": 2.5
      }
    },

    {
      "id": "place-state",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 5,
      "maxzoom": 10,
      "filter": ["all",
        ["==", "$type", "Point"],
        ["==", "class", "state"]
      ],
      "layout": {
        "text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 5, 10, 9, 14],
        "text-anchor": "center",
        "text-transform": "uppercase",
        "text-letter-spacing": 0.1,
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#555555",
        "text-halo-color": "rgba(255,255,255,0.8)",
